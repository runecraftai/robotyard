{
  "name": "robotyard",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "verify": "bun run typecheck && bun run lint && bun run test && bun run build",
    "boundary": "bash tools/boundary-check/run.sh"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "oxlint": "^1.9.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
